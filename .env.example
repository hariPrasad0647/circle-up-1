# ───────────────────────────────
# SERVER
# ───────────────────────────────
PORT=5000
NODE_ENV=development

# ───────────────────────────────
# DATABASE
# Local (XAMPP MySQL): DB_HOST=localhost, DB_PORT=3306, DB_SSL=false
# TiDB Cloud: DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com, DB_PORT=4000, DB_SSL=true
# ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=circleup_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# ───────────────────────────────
# JWT
# ───────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ───────────────────────────────
# REDIS (OTP & Cache)
# ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───────────────────────────────
# OTP
# ───────────────────────────────
OTP_EXPIRES_IN=300
PENDING_SIGNUP_EXPIRES_IN=86400

# ───────────────────────────────
# EMAIL (Brevo SMTP)
# ───────────────────────────────
BREVO_SMTP_PASS=
BREVO_SMTP_USER=
EMAIL_FROM=
BREVO_API_KEY=

# ───────────────────────────────
# FILE UPLOAD
# ───────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ───────────────────────────────
# CLIENT
# ───────────────────────────────
CLIENT_URL=http://localhost:3000

# ───────────────────────────────
# BUNNY STORAGE
# ───────────────────────────────
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_ENDPOINT=
BUNNY_CDN_URL=
