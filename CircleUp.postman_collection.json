{
  "info": {
    "name": "CircleUp API",
    "_postman_id": "circleup-api-collection",
    "description": "Complete API collection for CircleUp.\n\nVariables:\n  {{baseUrl}}  — https://circle-up-fk10.onrender.com (change to http://localhost:5000 for local)\n  {{token}}    — paste your JWT access token here after login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://circle-up-fk10.onrender.com", "type": "string" },
    { "key": "token",   "value": "",                                      "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","auth","signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+1234567890\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api","auth","verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api","auth","resend-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users — Own Account",
      "description": "Endpoints that act on the currently authenticated user's own account.",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api","users","profile"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName",     "value": "John Doe",         "type": "text" },
                { "key": "username",     "value": "johndoe",          "type": "text" },
                { "key": "bio",          "value": "Hello world!",     "type": "text" },
                { "key": "profession",   "value": "Software Engineer","type": "text" },
                { "key": "isPrivate",    "value": "false",            "type": "text" },
                { "key": "profileImage", "src": "",                   "type": "file", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Save Interests",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/interests", "host": ["{{baseUrl}}"], "path": ["api","users","interests"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interests\": [\"Technology\", \"Design\", \"Music\", \"Travel\", \"Fitness\"]\n}"
            }
          }
        },
        {
          "name": "Get My Interests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/interests", "host": ["{{baseUrl}}"], "path": ["api","users","interests"] }
          }
        },
        {
          "name": "Get Saved Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/saved/posts", "host": ["{{baseUrl}}"], "path": ["api","users","saved","posts"] }
          }
        },
        {
          "name": "Get Saved Reels",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/saved/reels", "host": ["{{baseUrl}}"], "path": ["api","users","saved","reels"] }
          }
        }
      ]
    },
    {
      "name": "Users — Discovery",
      "description": "Followers, following, friends, and suggestions for the authenticated user.",
      "item": [
        {
          "name": "Get Followers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/followers", "host": ["{{baseUrl}}"], "path": ["api","users","followers"] }
          }
        },
        {
          "name": "Get Following",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/following", "host": ["{{baseUrl}}"], "path": ["api","users","following"] }
          }
        },
        {
          "name": "Get Friends (Mutual Followers)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/friends", "host": ["{{baseUrl}}"], "path": ["api","users","friends"] }
          }
        },
        {
          "name": "Get Suggestions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/suggestions", "host": ["{{baseUrl}}"], "path": ["api","users","suggestions"] }
          }
        }
      ]
    },
    {
      "name": "Users — Follow",
      "description": "Send, accept, reject follow requests and unfollow.",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/:id/follow", "host": ["{{baseUrl}}"], "path": ["api","users",":id","follow"], "variable": [{ "key": "id", "value": "USER_ID" }] }
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/:id/follow", "host": ["{{baseUrl}}"], "path": ["api","users",":id","follow"], "variable": [{ "key": "id", "value": "USER_ID" }] }
          }
        },
        {
          "name": "Get Follow Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/follow-requests", "host": ["{{baseUrl}}"], "path": ["api","users","follow-requests"] }
          }
        },
        {
          "name": "Accept Follow Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/follow-requests/:id/accept", "host": ["{{baseUrl}}"], "path": ["api","users","follow-requests",":id","accept"], "variable": [{ "key": "id", "value": "USER_ID" }] }
          }
        },
        {
          "name": "Reject Follow Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/follow-requests/:id/reject", "host": ["{{baseUrl}}"], "path": ["api","users","follow-requests",":id","reject"], "variable": [{ "key": "id", "value": "USER_ID" }] }
          }
        }
      ]
    },
    {
      "name": "Users — Profile View",
      "description": "View another user's public profile, posts, and reels.\n\nPrivacy rules:\n  • Public account   → always accessible\n  • Private account  → profile info always visible; posts/reels require accepted follow\n  • Own profile      → always full access\n\nfollowStatus in profile response: \"following\" | \"pending\" | \"none\" | null (own profile)",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api","users",":id"],
              "variable": [{ "key": "id", "value": "USER_ID" }]
            }
          }
        },
        {
          "name": "Get User Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/:id/posts?page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api","users",":id","posts"],
              "variable": [{ "key": "id", "value": "USER_ID" }],
              "query": [
                { "key": "page",  "value": "1",  "description": "Page number (default 1)" },
                { "key": "limit", "value": "12", "description": "Items per page (default 12)" }
              ]
            }
          }
        },
        {
          "name": "Get User Reels",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/:id/reels?page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api","users",":id","reels"],
              "variable": [{ "key": "id", "value": "USER_ID" }],
              "query": [
                { "key": "page",  "value": "1",  "description": "Page number (default 1)" },
                { "key": "limit", "value": "12", "description": "Items per page (default 12)" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/posts", "host": ["{{baseUrl}}"], "path": ["api","posts"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "caption",   "value": "My first post!", "type": "text" },
                { "key": "isPrivate", "value": "false",          "type": "text" },
                { "key": "images",    "src": [],                 "type": "file", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Post",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/posts/:id", "host": ["{{baseUrl}}"], "path": ["api","posts",":id"], "variable": [{ "key": "id", "value": "POST_ID" }] }
          }
        },
        {
          "name": "Like / Unlike Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/posts/:id/like", "host": ["{{baseUrl}}"], "path": ["api","posts",":id","like"], "variable": [{ "key": "id", "value": "POST_ID" }] }
          }
        },
        {
          "name": "Save / Unsave Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/posts/:id/save", "host": ["{{baseUrl}}"], "path": ["api","posts",":id","save"], "variable": [{ "key": "id", "value": "POST_ID" }] }
          }
        },
        {
          "name": "Share Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/posts/:id/share", "host": ["{{baseUrl}}"], "path": ["api","posts",":id","share"], "variable": [{ "key": "id", "value": "POST_ID" }] }
          }
        }
      ]
    },
    {
      "name": "Reels",
      "item": [
        {
          "name": "Create Reel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reels", "host": ["{{baseUrl}}"], "path": ["api","reels"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "caption",   "value": "Check out my reel!", "type": "text" },
                { "key": "isPrivate", "value": "false",               "type": "text" },
                { "key": "video",     "src": "",                      "type": "file", "disabled": true },
                { "key": "thumbnail", "src": "",                      "type": "file", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Reel",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reels/:id", "host": ["{{baseUrl}}"], "path": ["api","reels",":id"], "variable": [{ "key": "id", "value": "REEL_ID" }] }
          }
        },
        {
          "name": "Like / Unlike Reel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reels/:id/like", "host": ["{{baseUrl}}"], "path": ["api","reels",":id","like"], "variable": [{ "key": "id", "value": "REEL_ID" }] }
          }
        },
        {
          "name": "Save / Unsave Reel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reels/:id/save", "host": ["{{baseUrl}}"], "path": ["api","reels",":id","save"], "variable": [{ "key": "id", "value": "REEL_ID" }] }
          }
        },
        {
          "name": "Share Reel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reels/:id/share", "host": ["{{baseUrl}}"], "path": ["api","reels",":id","share"], "variable": [{ "key": "id", "value": "REEL_ID" }] }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "description": "Direct messaging — REST endpoints for history, and Socket.io for real-time.\n\n── Socket.io connection ───────────────────────────────────────────\nio('{{baseUrl}}', { auth: { token: '<JWT>' } })\n\nClient → Server:\n  chat:send        { recipientId, content?, media?: [{ mediaUrl, mediaType, thumbnailUrl? }] }\n  chat:typing      { recipientId }\n  chat:stop_typing { recipientId }\n  chat:read        { conversationId, senderId }\n\nServer → Client:\n  chat:message     { conversationId, message }\n  chat:typing      { senderId }\n  chat:stop_typing { senderId }\n  chat:read        { conversationId, readBy }\n  chat:error       { message }\n\nMedia flow: POST /api/chat/upload → { mediaUrl, mediaType } → pass in media[] of chat:send\nPrivacy: cannot message a private account unless you are mutual followers.",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/chat/send",
              "host": ["{{baseUrl}}"],
              "path": ["api","chat","send"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "recipientId", "value": "USER_ID",      "type": "text",  "description": "Required — UUID of the user you are messaging" },
                { "key": "content",     "value": "Hello! 👋",    "type": "text",  "description": "Optional text content" },
                { "key": "file",        "src": "",               "type": "file",  "description": "Optional image (≤5 MB) or video (≤100 MB). Attach this OR leave empty for text-only.", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/chat/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api","chat","conversations"]
            }
          }
        },
        {
          "name": "Get Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/chat/conversations/:conversationId/messages?limit=30",
              "host": ["{{baseUrl}}"],
              "path": ["api","chat","conversations",":conversationId","messages"],
              "variable": [{ "key": "conversationId", "value": "CONVERSATION_ID" }],
              "query": [
                { "key": "limit",  "value": "30", "description": "Messages per page (default 30)" },
                { "key": "before", "value": "",   "description": "ISO timestamp — cursor for older messages", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Upload Chat Media",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/chat/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api","chat","upload"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "src": "",
                  "type": "file",
                  "description": "Image (jpg/jpeg/png/webp ≤ 5 MB) or video (mp4/mov/avi/webm/mkv ≤ 100 MB)"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/chat/messages/:messageId",
              "host": ["{{baseUrl}}"],
              "path": ["api","chat","messages",":messageId"],
              "variable": [{ "key": "messageId", "value": "MESSAGE_ID" }]
            }
          }
        }
      ]
    }
  ]
}
